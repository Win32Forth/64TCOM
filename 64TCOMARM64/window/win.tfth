\ win.tfth — Layer 4 blank-window MVP (APP-NAME + WINDOW)
\
\   FLOAD TARGETARM64.fth
\   TCOM window/win.tfth
\   open window/win.app          \ or double-click in Finder
\
\ Optional Finder icon: place a 1024×1024 PNG beside this file as
\   window/win.png
\ then rebuild with TCOM (see window/README.txt).
\
\ Sets the menu-bar / window title via APP-NAME, then opens a blank
\ NSWindow. Stays until quit (close button or Cmd-Q).
\ Default name is "64TCOM" if APP-NAME is omitted.

: MAIN
  S" Demo" APP-NAME
  WINDOW
  0
;
